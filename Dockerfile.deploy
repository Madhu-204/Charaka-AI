# Stage 1 — build the frontend SPA (VITE_API_URL empty -> same-origin / relative fetches)
FROM node:20-alpine AS fe
WORKDIR /build
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Stage 2 — backend + baked corpus + vector store + SPA statics
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TRANSFORMERS_CACHE=/root/.cache/torch/sentence_transformers

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r backend/requirements.txt \
    && python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY backend/app backend/app
COPY backend/scripts backend/scripts
COPY backend/reference backend/reference
COPY backend/charaka_data backend/charaka_data
# processed/ and chroma_db/ are git-ignored, so regenerate them in-image from
# the committed raw corpus — this is what makes the deploy build from a clean
# checkout (Render/CI). audit_ids.py exits non-zero on any integrity failure.
RUN python backend/scripts/transform.py \
    && python backend/scripts/audit_ids.py \
    && python backend/scripts/build_vector_store.py
COPY --from=fe /build/dist frontend/dist

# Run from backend/ so the `app` package is importable and the SPA resolves at
# ../frontend/dist (see FRONTEND_DIST in app/main.py).
WORKDIR /app/backend
# All models are baked into the image at build time; never dial out to the Hub
# at runtime (avoids DNS retry stalls on startup — important for cold starts).
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
EXPOSE 7860
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}"]