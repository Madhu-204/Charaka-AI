# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=<api-key-here>

# Optional production hardening
CHARAKA_AUTH_REQUIRED=1      # 1 = sign-in required (default). 0 = no login at all:
                            # the SPA skips AuthView and every visitor shares the
                            # single "shared" owner, so conversations/documents are
                            # readable and deletable by anyone who can load the page.
CHARAKA_API_KEY=            # if set, /ask + private routes require matching X-API-Key header
CHARAKA_ADMIN_KEY=          # if set, /stats, /traces, /eval/* require this key (not API_KEY)
CHARAKA_RATE_LIMIT=30       # requests per minute per client (token bucket)
CHARAKA_RATE_BURST=60       # burst capacity
CHARAKA_CACHE_SIZE=64       # LRU query-cache capacity (entries)
CHARAKA_CACHE_TTL=3600      # cache TTL in seconds
CHARAKA_LLM_CONCURRENCY=2   # max simultaneous agent runs (free-tier token ceiling is 8K TPM;
                            # one synthesize call is ~3.5K, so 2 is the safe ceiling)
CHARAKA_LLM_QUEUE_TIMEOUT=45 # seconds to wait for a slot before returning 503

# Agent guardrails. Each LLM call is individually capped at 60s, so a single
# request can otherwise chain three of them and outlast the client's own 180s
# abort while still holding one of only two Groq slots.
CHARAKA_REQUEST_DEADLINE_S=90 # wall-clock ceiling per streamed request
CHARAKA_RECURSION_LIMIT=25   # max graph steps per request. The graph is no longer
                             # acyclic: grounding may retry synthesis once. Longest simple
                             # path is 12 steps and the permitted retry adds 2, so the real
                             # ceiling is 14. 25 leaves headroom and stops any further
                             # back-edge from becoming an unbounded loop.
CHARAKA_MAX_QUERY_CHARS=2000 # rejects oversized /ask and /feedback bodies before they
                             # reach the retrieval and synthesis prompt path

# How many prior turns reach the synthesis prompt, and therefore how much of a
# long thread survives. Raising it costs prompt tokens on every request, and the
# free tier is token-metered, so raising it is a budget decision rather than a
# tuning one. Also defines the window hashed into the query cache key, so the two
# can never disagree about what "recent" means.
CHARAKA_MAX_HISTORY_TURNS=6

# Semantic citation check. Off by default: it asks the model whether each cited
# verse actually states the claim attached to it, which the structural citation
# check cannot do. Costs one extra LLM call per request, so on an 8K TPM shared
# tier it must be measured before it is switched on. When on, the worst case is
# two synthesis calls plus one verification.
CHARAKA_SEMANTIC_CHECK=0

# Log retention and PII redaction. Every line written to traces.jsonl and
# feedback_log.jsonl is passed through redact_pii() first (emails, phone
# numbers, Aadhaar and PAN ids, and anything that looks like a card number), and
# both files rotate so they cannot grow without bound. Rotation keeps the most
# recent KEEP_LINES records and only fires once the file passes MAX_BYTES.
CHARAKA_LOG_MAX_BYTES=2000000 # rotate traces/feedback once the file passes ~2 MB
CHARAKA_LOG_KEEP_LINES=2000    # records retained after a rotation

# Optional expiry for per-session uploaded-document vectors. Document
# collections are keyed by a client-supplied session scope, so every new browser
# session mints another collection in user_chroma_db/ and nothing else ever
# removed them - that directory only grows. Setting this to a positive number of
# days deletes a collection after that many days without an upload or a
# document listing. It is UNSET (disabled) by default on purpose: deleting a
# user's uploaded documents is a data-loss action and turning it on should be a
# deliberate operational decision, not a side effect of a deploy.
# Tracking uses a small sidecar (user_chroma_db/scopes.json), so activity only
# counts once this has been enabled at least once.
CHARAKA_DOC_TTL_DAYS=          # e.g. 30. Unset / 0 / negative = never reap

# Comma-separated browser origins allowed to call the API. Unset = allow all
# (fine for local dev, not for a public deployment).
CHARAKA_ALLOWED_ORIGINS=http://localhost:5173