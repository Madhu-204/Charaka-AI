# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=<api-key-here>

# Optional production hardening
CHARAKA_API_KEY=            # if set, /ask endpoints require matching X-API-Key header
CHARAKA_RATE_LIMIT=30       # requests per minute per client (token bucket)
CHARAKA_RATE_BURST=60       # burst capacity
CHARAKA_CACHE_SIZE=64       # LRU query-cache capacity (entries)
CHARAKA_CACHE_TTL=3600      # cache TTL in seconds